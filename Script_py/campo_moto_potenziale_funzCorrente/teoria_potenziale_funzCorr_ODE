# ===============================
# CALCOLO FORZA AERODINAMICA (LIFT)
# ===============================
if cylinder_type == "portante":
    L = rho * V_inf * Gamma   # Formula di Kutta–Joukowski
    print(f"Forza di sollevamento (per unità di lunghezza) L = {L:.3f}")
else:
    L = 0.0
    print("Cilindro non portante → L = 0")

